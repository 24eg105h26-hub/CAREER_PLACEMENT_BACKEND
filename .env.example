# ==============================================================================
# SMARTPLACEMENT BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to '.env' and fill in real production / deployment credentials.
# Never commit real secrets to source control.
# ==============================================================================

# --- Profile & Server ---
# Application profile: 'dev' (uses in-memory H2 or local DB) or 'prod' (strict validation, no seeders)
SPRING_PROFILES_ACTIVE=dev

# Server listening port (Render, Railway, Heroku and Cloud Run set PORT automatically)
PORT=8080

# --- Database Configuration (Managed MySQL / RDS / PlanetScale) ---
# Primary JDBC connection URL (Supports SSL parameters for cloud DBs)
# Example: jdbc:mysql://db.host.com:3306/smartplacement?useSSL=true&requireSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/smartplacement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Alternative variable alias:
MYSQL_URL=jdbc:mysql://localhost:3306/smartplacement?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=smartuser
DB_PASSWORD=your_strong_db_password_here
MYSQL_USERNAME=smartuser
MYSQL_PASSWORD=your_strong_db_password_here

# Hikari Connection Pool Settings
DB_POOL_MAX_SIZE=15
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=30000
DB_POOL_MAX_LIFETIME=1800000

# --- Security & JWT ---
# Required secret for HS256 JWT signing. MUST be at least 32 characters (min 256 bits).
# Generate using: openssl rand -hex 32
JWT_SECRET=your_minimum_32_character_random_secret_key_here
# Token expiration in minutes (e.g. 1440 for 24 hours)
JWT_EXPIRATION_MINUTES=1440
# Alternatively token expiration in milliseconds
JWT_EXPIRATION_MS=86400000

# --- CORS & Networking ---
# Comma-separated list of allowed frontend origins (No wildcards in production)
# Example: https://smartplacement.app,https://admin.smartplacement.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- AI Integration (Google Gemini) ---
# AI Mode: 'live' (cloud AI provider) or 'dev-fallback' (local algorithmic mock)
AI_MODE=live
# Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_MODEL=gemini-2.5-flash
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# --- File Storage & Uploads ---
# Local or mounted persistent volume storage path for resumes
# Note: In production cloud containers, map this path to a persistent volume or object storage.
FILE_STORAGE_PATH=uploads/resumes
MAX_UPLOAD_SIZE=5MB

# --- Seeders & Documentation ---
# Default password applied to seeded test accounts (Students, TPO, Faculty, Admin)
SEED_DEFAULT_PASSWORD=Password123!
# Whether data seeder should run on startup (Set false in production)
SEED_ENABLED=true
# Enable Swagger/OpenAPI UI (Set false in production)
SWAGGER_ENABLED=true

# Optional GitHub Integration
GITHUB_TOKEN=
