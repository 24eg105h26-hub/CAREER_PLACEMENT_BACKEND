# ==========================================
# SMARTPLACEMENT AI - CONFIGURATION
# ==========================================

# AI Mode: 'live' (cloud AI provider) or 'dev-fallback' (local dynamic engine)
AI_MODE=live

# ------------------------------------------
# Google Gemini (Active Provider)
GEMINI_API_KEY=your-gemini-api-key-here
# ------------------------------------------
# 1. Get your free API key at: https://aistudio.google.com/app/apikey
# 2. Paste your Gemini API key below (replace 'your-gemini-api-key-here')
AI_API_KEY=your-gemini-api-key-here
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_MODEL=gemini-1.5-flash

# ------------------------------------------
# Alternative: OpenAI
# ------------------------------------------
# AI_API_KEY=your-openai-api-key-here
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini

# ------------------------------------------
# Alternative: Groq (Ultra-Fast)
# ------------------------------------------
# AI_API_KEY=gsk_your_groq_key_here
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.3-70b-versatile

# Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
SEED_DEFAULT_PASSWORD=Password123!

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
FILE_STORAGE_PATH=uploads/resumes
